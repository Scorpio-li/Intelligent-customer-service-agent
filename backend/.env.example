# DeepSeek API Key — https://platform.deepseek.com
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# DashScope (通义千问) API Key — https://dashscope.console.aliyun.com
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# 模型名称（可选，不填则用默认值 deepseek-flash / qwen-plus）
DEEPSEEK_MODEL=deepseek-flash
DASHSCOPE_MODEL=qwen-plus

# 知识库检索（命中则跳过 LLM，直接返回条目）
KB_EMBEDDING_THRESHOLD=0.6
KB_EMBEDDING_ENABLED=true
EMBEDDING_MODEL=text-embedding-v3

# 混合检索：BM25 与向量并行召回 → RRF 融合 → rerank 精排
KB_BM25_TOP_K=10
KB_VECTOR_TOP_K=10
KB_RERANK_TOP_N=5
KB_FINAL_TOP_K=3
KB_RRF_K=60
# rerank 不可用时，BM25 原始分与向量余弦的判定阈值
KB_BM25_THRESHOLD=0.4
KB_RERANK_ENABLED=true
RERANK_MODEL=gte-rerank-v2
# gte-rerank-v2 分数普遍偏低（相关结果约 0.12~0.9）
KB_RERANK_THRESHOLD=0.1
# /api/metrics 成本估算单价（元 / 千 token），按实际计费调整
KB_COST_EMBED_CNY_PER_1K=0.0007
KB_COST_RERANK_CNY_PER_1K=0.0008

# 离线向量索引文件路径（相对启动目录，默认 data/vector-index.json）
# 由 npm run build:index 生成；缺失时自动回退实时向量化
VECTOR_INDEX_PATH=data/vector-index.json

# 知识库存储：qdrant（默认，条目+向量都在 Qdrant）| local（本地种子 + 离线索引，无外部依赖）
KB_VECTOR_STORE=qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=knowledge_entries
EMBEDDING_DIM=1024
# 条目快照缓存 TTL（毫秒），热更新会立即失效；多实例部署靠 TTL 收敛
KB_CACHE_TTL_MS=30000
# 管理接口 /api/kb 的 Bearer Token；留空表示不校验（仅内网使用）
KB_ADMIN_TOKEN=

# 后端端口
PORT=3001
